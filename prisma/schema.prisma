generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS DÙNG CHUNG
// ==========================================

enum UserRole {
  STUDENT
  ADVISOR
  TRAINING_OFFICER
  ADMIN
}

enum OfficialAcademicStatus {
  ACTIVE
  RESERVED
  SUSPENDED
  GRADUATED
  DISMISSED
}

enum SectionStatus {
  NOT_STARTED
  ONGOING
  ENDED
}

enum EnrollmentStatus {
  REGISTERED
  WITHDRAWN
  COMPLETED
  CANCELLED_BY_SECTION
}

enum EnrollmentType {
  NORMAL
  RETAKE_FAILED
  RETAKE_IMPROVEMENT
  RETAKE_CURRICULUM_CHANGE
}

enum AttemptOutcome {
  PENDING
  PASSED
  FAILED
  WITHDRAWN
}

enum SessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

// ==========================================
// 2. IDENTITY & ENROLLMENT (09-data-schema-identity.md)
// ==========================================

model User {
  userId        String   @id
  id            String   @unique @default(dbgenerated("gen_random_uuid()"))
  fullName      String   @db.VarChar(100)
  role          UserRole
  email         String   @unique @db.VarChar(100)
  emailVerified Boolean  @default(false)
  image         String?
  /// validate bằng Zod, xem UserScopeConfigSchema
  scopeConfig   Json?

  // Relations nghiệp vụ
  advisedStudents Student[]       @relation("AdvisorStudents")
  taughtSections  CourseSection[] @relation("InstructorSections")

  // Relations Better Auth
  sessions Session[]
  accounts Account[]

  // Phase 2 relations
  importBatches        ImportBatch[]            @relation("ImportBatchPerformer")
  deadlineExtensions   LMSDeadlineExtension[]   @relation("DeadlineExtensionGrantor")
  assignmentExemptions LMSAssignmentExemption[] @relation("AssignmentExemptionGrantor")

  // Phase 3 relations
  configuredRuleVersions RuleVersion[]  @relation("RuleVersionConfigurator")
  approvedRuleVersions   RuleVersion[]  @relation("RuleVersionApprover")
  assignedAlerts         Alert[]        @relation("AlertAssignedAdvisor")
  interventions          Intervention[]
  notifications          Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  studentId              String                 @id @db.VarChar(20)
  fullName               String                 @db.VarChar(100)
  classId                String                 @db.VarChar(20)
  departmentId           String                 @db.VarChar(10)
  cohortYear             String                 @db.VarChar(10)
  advisorId              String                 @db.VarChar(20)
  officialAcademicStatus OfficialAcademicStatus

  advisor     User         @relation("AdvisorStudents", fields: [advisorId], references: [userId])
  enrollments Enrollment[]

  // Phase 2 relations
  deadlineExtensions   LMSDeadlineExtension[]
  assignmentExemptions LMSAssignmentExemption[]

  // Phase 3 relations
  ruleTriggers  RuleTrigger[]
  riskScoreLogs RiskScoreLog[]
  alerts        Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Term {
  termId       String   @id @db.VarChar(10)
  termName     String   @db.VarChar(50)
  academicYear String   @db.VarChar(10)
  startDate    DateTime
  endDate      DateTime

  courseSections CourseSection[]

  // Phase 3 relations
  ruleTriggers  RuleTrigger[]
  riskScoreLogs RiskScoreLog[]
  alerts        Alert[]
}

model Course {
  courseId   String @id @db.VarChar(20)
  courseName String @db.VarChar(150)
  credits    Int

  courseSections CourseSection[]
}

model CourseSection {
  courseSectionId String        @id @db.VarChar(20)
  courseId        String        @db.VarChar(20)
  termId          String        @db.VarChar(10)
  instructorId    String?       @db.VarChar(20)
  usesLMS         Boolean
  sectionStatus   SectionStatus

  course         Course                  @relation(fields: [courseId], references: [courseId])
  term           Term                    @relation(fields: [termId], references: [termId])
  instructor     User?                   @relation("InstructorSections", fields: [instructorId], references: [userId])
  enrollments    Enrollment[]
  schedules      CourseSessionSchedule[]
  lmsAssignments LMSAssignment[]
}

model Enrollment {
  enrollmentId     String           @id @default(uuid())
  studentId        String           @db.VarChar(20)
  courseSectionId  String           @db.VarChar(20)
  enrollmentStatus EnrollmentStatus
  registeredAt     DateTime
  withdrawnAt      DateTime?
  attemptNumber    Int
  attemptOutcome   AttemptOutcome?
  enrollmentType   EnrollmentType
  sourceSystem     String           @db.VarChar(30)
  sourceRecordKey  String           @db.VarChar(50)
  importBatchId    String           @default("bootstrap-batch")

  student       Student       @relation(fields: [studentId], references: [studentId])
  courseSection CourseSection @relation(fields: [courseSectionId], references: [courseSectionId])

  // Phase 2 relations
  attendanceRecords AttendanceRecord[]
  assessmentResults AssessmentResult[]
  lmsSubmissions    LMSSubmission[]
  lmsActivityEvents LMSActivityEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceSystem, sourceRecordKey])
}

model CourseSessionSchedule {
  sessionId       String        @id @default(uuid())
  courseSectionId String        @db.VarChar(20)
  sessionDate     DateTime      @db.Date
  sessionStatus   SessionStatus
  cancelReason    String?       @db.Text

  courseSection     CourseSection      @relation(fields: [courseSectionId], references: [courseSectionId])
  attendanceRecords AttendanceRecord[]

  @@unique([courseSectionId, sessionDate])
}

// ==========================================
// 3. BETTER AUTH TABLES
// ==========================================

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ==========================================
// 4. ENUMS — DATA-IMPORT & SOURCE RECORDS
// ==========================================

enum AttendanceStatus {
  PRESENT
  EXCUSED_ABSENCE
  UNEXCUSED_ABSENCE
  LATE
}

enum ResultStatus {
  DRAFT
  FINAL
  UNDER_APPEAL
  EXEMPT
  WAIVED
}

enum LMSAssignmentType {
  QUIZ
  HOMEWORK
  DISCUSSION
  PROJECT
}

enum LMSAssignmentStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum LMSSubmissionStatus {
  ON_TIME
  LATE
}

enum LMSEventType {
  VIEW_MATERIAL
  DISCUSSION_POST
  LOGIN
  ACTIVITY_COMPLETE
}

enum ImportDataType {
  ENROLLMENT
  ATTENDANCE
  ASSESSMENT
  LMS_ASSIGNMENT
  LMS_SUBMISSION
  LMS_EVENT
}

enum DataSource {
  FILE
  API
}

enum ImportBatchStatus {
  UPLOADING
  VALIDATING
  STAGED
  LOADED
  RECONCILED
  REJECTED
  DISCARDED
}

enum ImportErrorReason {
  INVALID_FORMAT
  NOT_IN_CATALOG
  DUPLICATE
  OUT_OF_RANGE
  NOT_ENROLLED
}

enum CalendarExceptionType {
  HOLIDAY
  MAKEUP_SESSION
  EXAM_WEEK
}

// ==========================================
// 5. SOURCE RECORDS (10-data-schema-source-records.md)
// ==========================================

model AttendanceRecord {
  id               String           @id @default(uuid())
  enrollmentId     String
  sessionId        String
  attendanceStatus AttendanceStatus
  source           String           @db.VarChar(20)
  importBatchId    String
  updatedAt        DateTime         @updatedAt

  enrollment  Enrollment            @relation(fields: [enrollmentId], references: [enrollmentId])
  session     CourseSessionSchedule @relation(fields: [sessionId], references: [sessionId])
  importBatch ImportBatch           @relation(fields: [importBatchId], references: [id])

  @@unique([enrollmentId, sessionId])
}

model AssessmentResult {
  id             String       @id @default(uuid())
  enrollmentId   String
  assessmentType String       @db.VarChar(30)
  weight         Float
  score          Float?
  scoreScale     String       @db.VarChar(10)
  resultStatus   ResultStatus
  importBatchId  String
  publishedAt    DateTime?

  enrollment  Enrollment  @relation(fields: [enrollmentId], references: [enrollmentId])
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@unique([enrollmentId, assessmentType])
}

model LMSAssignment {
  assignmentId    String              @id @db.VarChar(30)
  courseSectionId String              @db.VarChar(20)
  assignmentType  LMSAssignmentType
  title           String              @db.VarChar(150)
  isRequired      Boolean
  defaultDeadline DateTime
  sequenceNumber  Int
  status          LMSAssignmentStatus
  importBatchId   String

  courseSection CourseSection            @relation(fields: [courseSectionId], references: [courseSectionId])
  importBatch   ImportBatch              @relation(fields: [importBatchId], references: [id])
  submissions   LMSSubmission[]
  extensions    LMSDeadlineExtension[]
  exemptions    LMSAssignmentExemption[]
}

model LMSDeadlineExtension {
  id           String   @id @default(uuid())
  assignmentId String   @db.VarChar(30)
  studentId    String?  @db.VarChar(20)
  newDeadline  DateTime
  reason       String?  @db.Text
  grantedBy    String   @db.VarChar(20)
  grantedAt    DateTime

  assignment LMSAssignment @relation(fields: [assignmentId], references: [assignmentId])
  student    Student?      @relation(fields: [studentId], references: [studentId])
  grantor    User          @relation("DeadlineExtensionGrantor", fields: [grantedBy], references: [userId])
}

model LMSAssignmentExemption {
  id           String   @id @default(uuid())
  assignmentId String   @db.VarChar(30)
  studentId    String?  @db.VarChar(20)
  reason       String?  @db.Text
  grantedBy    String   @db.VarChar(20)
  grantedAt    DateTime

  assignment LMSAssignment @relation(fields: [assignmentId], references: [assignmentId])
  student    Student?      @relation(fields: [studentId], references: [studentId])
  grantor    User          @relation("AssignmentExemptionGrantor", fields: [grantedBy], references: [userId])
}

model LMSSubmission {
  submissionId     String              @id @default(uuid())
  assignmentId     String              @db.VarChar(30)
  enrollmentId     String
  attemptNumber    Int
  isLatest         Boolean
  submittedAt      DateTime
  score            Float?
  submissionStatus LMSSubmissionStatus
  importBatchId    String

  assignment  LMSAssignment @relation(fields: [assignmentId], references: [assignmentId])
  enrollment  Enrollment    @relation(fields: [enrollmentId], references: [enrollmentId])
  importBatch ImportBatch   @relation(fields: [importBatchId], references: [id])

  @@unique([assignmentId, enrollmentId, attemptNumber])
}

model LMSActivityEvent {
  eventId       String       @id @default(uuid())
  enrollmentId  String
  eventType     LMSEventType
  timestamp     DateTime
  resourceId    String?      @db.VarChar(30)
  importBatchId String

  enrollment  Enrollment  @relation(fields: [enrollmentId], references: [enrollmentId])
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])
}

// ==========================================
// 6. IMPORT & OPERATIONAL (12-data-schema-ops.md)
// ==========================================

model ImportBatch {
  id               String            @id @default(uuid())
  dataType         ImportDataType
  source           DataSource
  sourceChecksum   String            @db.VarChar(64)
  performedBy      String            @db.VarChar(20)
  status           ImportBatchStatus
  totalRows        Int
  successRows      Int
  errorRows        Int
  parentBatchId    String?
  originalFilePath String            @db.VarChar(255)
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  performer    User             @relation("ImportBatchPerformer", fields: [performedBy], references: [userId])
  parentBatch  ImportBatch?     @relation("BatchCorrection", fields: [parentBatchId], references: [id])
  childBatches ImportBatch[]    @relation("BatchCorrection")
  errorRows_   ImportErrorRow[]

  // Reverse relations from source records
  attendanceRecords AttendanceRecord[]
  assessmentResults AssessmentResult[]
  lmsAssignments    LMSAssignment[]
  lmsSubmissions    LMSSubmission[]
  lmsActivityEvents LMSActivityEvent[]
}

model ImportErrorRow {
  id              String            @id @default(uuid())
  importBatchId   String
  sourceRowNumber Int
  rawData         Json
  errorReason     ImportErrorReason
  resolved        Boolean           @default(false)

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId, resolved])
}

model AcademicCalendarException {
  id            String                @id @default(uuid())
  exceptionDate DateTime              @db.Date
  type          CalendarExceptionType
  description   String?               @db.Text
}

model LMSMaintenanceWindow {
  id          String   @id @default(uuid())
  startAt     DateTime
  endAt       DateTime
  description String?  @db.Text
}

// ==========================================
// 7. ENUMS — RULE ENGINE & ALERTS (11-data-schema-rule-engine.md)
// ==========================================

enum RuleGroup {
  ATTENDANCE
  ACADEMIC
  LMS
  COMBINED
  EXCEPTION
}

enum RuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
  INVALIDATED
  REOPENED
}

enum InterventionType {
  EMAIL
  PHONE_CALL
  IN_PERSON_MEETING
  ACADEMIC_PLAN
  REFERRAL
  OTHER
}

enum ConfidentialityLevel {
  NORMAL
  SENSITIVE
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED_DUPLICATE
}

enum DataCompletenessLevel {
  FULL
  PARTIAL
  INSUFFICIENT
}

// ==========================================
// 8. RULE ENGINE & ALERTS (11-data-schema-rule-engine.md)
// ==========================================

model Rule {
  ruleCode  String     @id @db.VarChar(20)
  ruleName  String     @db.VarChar(100)
  ruleGroup RuleGroup
  scope     String     @db.VarChar(30)
  priority  Int
  cooldown  Int
  status    RuleStatus

  versions     RuleVersion[]
  ruleTriggers RuleTrigger[]
}

model RuleVersion {
  id            String     @id @default(uuid())
  ruleCode      String     @db.VarChar(20)
  version       Int
  /// validate bằng Zod, xem RuleVersionConditionSchema
  condition     Json
  severity      Severity
  /// validate bằng Zod, xem RuleVersionActionSchema
  action        Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        RuleStatus
  configuredBy  String     @db.VarChar(20)
  approvedBy    String?    @db.VarChar(20)

  rule          Rule           @relation(fields: [ruleCode], references: [ruleCode])
  configurator  User           @relation("RuleVersionConfigurator", fields: [configuredBy], references: [userId])
  approver      User?          @relation("RuleVersionApprover", fields: [approvedBy], references: [userId])
  ruleTriggers  RuleTrigger[]
  riskScoreLogs RiskScoreLog[]

  @@unique([ruleCode, version])
}

model RuleTrigger {
  id            String   @id @default(uuid())
  alertId       String
  ruleCode      String   @db.VarChar(20)
  ruleVersionId String
  studentId     String   @db.VarChar(20)
  scopeId       String   @db.VarChar(20)
  termId        String   @db.VarChar(10)
  triggeredAt   DateTime
  /// validate bằng Zod, xem TriggerInputSnapshotSchema
  inputSnapshot Json
  reason        String   @db.Text
  severity      Severity

  alert       Alert       @relation(fields: [alertId], references: [alertId])
  rule        Rule        @relation(fields: [ruleCode], references: [ruleCode])
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [studentId])
  term        Term        @relation(fields: [termId], references: [termId])

  @@index([termId, ruleCode])
  @@index([studentId, termId])
}

model RiskScoreLog {
  id                    String                @id @default(uuid())
  studentId             String                @db.VarChar(20)
  termId                String                @db.VarChar(10)
  riskScoreValue        Float?
  dataCompletenessLevel DataCompletenessLevel
  /// validate bằng Zod, xem ComponentsUsedSchema
  componentsUsed        Json
  ruleVersionId         String
  calculatedAt          DateTime

  student     Student     @relation(fields: [studentId], references: [studentId])
  term        Term        @relation(fields: [termId], references: [termId])
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id])
  alerts      Alert[]

  @@index([studentId, termId, calculatedAt])
}

model Alert {
  alertId           String      @id @default(uuid())
  studentId         String      @db.VarChar(20)
  termId            String      @db.VarChar(10)
  severity          Severity
  status            AlertStatus
  firstDetectedAt   DateTime
  lastDetectedAt    DateTime
  assignedAdvisorId String      @db.VarChar(20)
  riskScoreLogId    String?
  isReferenceOnly   Boolean     @default(true)

  student         Student        @relation(fields: [studentId], references: [studentId])
  term            Term           @relation(fields: [termId], references: [termId])
  assignedAdvisor User           @relation("AlertAssignedAdvisor", fields: [assignedAdvisorId], references: [userId])
  riskScoreLog    RiskScoreLog?  @relation(fields: [riskScoreLogId], references: [id])
  ruleTriggers    RuleTrigger[]
  interventions   Intervention[]
  notifications   Notification[]

  @@index([studentId, termId, status])
  @@index([termId, severity, status])
  @@index([assignedAdvisorId, status])
}

model Intervention {
  interventionId       String               @id @default(uuid())
  alertId              String
  performedBy          String               @db.VarChar(20)
  type                 InterventionType
  content              String               @db.Text
  performedAt          DateTime
  outcome              String?              @db.Text
  nextFollowUpAt       DateTime?
  status               String               @db.VarChar(20)
  confidentialityLevel ConfidentialityLevel

  alert     Alert @relation(fields: [alertId], references: [alertId])
  performer User  @relation(fields: [performedBy], references: [userId])
}

model Notification {
  notificationId String              @id @default(uuid())
  alertId        String
  recipientId    String              @db.VarChar(20)
  channel        NotificationChannel
  dedupKey       String              @db.VarChar(100)
  status         NotificationStatus
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  alert     Alert @relation(fields: [alertId], references: [alertId])
  recipient User  @relation(fields: [recipientId], references: [userId])

  @@index([dedupKey, createdAt])
}

// ==========================================
// 9. AUDIT & SYSTEM INTEGRATIONS (Phase 6 Admin)
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @db.VarChar(50)
  actorRole    String   @db.VarChar(50)
  action       String   @db.VarChar(50)
  targetEntity String   @db.VarChar(50)
  targetId     String?  @db.VarChar(100)
  details      Json?
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetEntity, createdAt])
}

model SystemIntegrationConfig {
  id           String    @id @default(uuid())
  systemType   String    @unique @db.VarChar(50)
  name         String    @db.VarChar(100)
  baseUrl      String    @db.VarChar(255)
  apiKey       String?   @db.Text
  apiSecret    String?   @db.Text
  isEnabled    Boolean   @default(true)
  syncSchedule String?   @db.VarChar(50)
  lastSyncAt   DateTime?
  configJson   Json?
  updatedBy    String    @db.VarChar(50)
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}
